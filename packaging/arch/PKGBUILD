pkgname=tinyhand
pkgver=0.1.0
pkgrel=1
pkgdesc="A tiny hand on a stick that points at things on your screen"
arch=('x86_64' 'aarch64')
url="https://github.com/xdinterface/tinyhand-linux"
license=('MIT')
depends=('gtk4' 'libadwaita' 'gtk4-layer-shell' 'alsa-lib')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "tinyhand-linux-$pkgver"
  make build
}

package() {
  cd "tinyhand-linux-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
